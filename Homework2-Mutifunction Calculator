#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

// 1. 内联函数：计算平方
inline double square(double x) {
    return x * x;
}

// 2. 带默认参数值的函数：计算乘幂
double power(double base, int exponent = 2) {
    return pow(base, exponent);
}

// 3. 重载函数：double类型的四则运算
double calc(double a, double b, char op) {
    switch (op) {
        case '+':
            return a + b;
        case '-':
            return a - b;
        case '*':
            return a * b;
        case '/':
            if (b == 0) {
                cout << "Error: divide by zero" << endl;
                return 0;
            }
            return a / b;
        default:
            cout << "Error: invalid operator" << endl;
            return 0;
    }
}

// 3. 重载函数：int类型的四则运算
double calc(int a, int b, char op) {
    switch (op) {
        case '+':
            return a + b;
        case '-':
            return a - b;
        case '*':
            return a * b;
        case '/':
            if (b == 0) {
                cout << "Error: divide by zero" << endl;
                return 0;
            }
            return static_cast<double>(a) / b;
        default:
            cout << "Error: invalid operator" << endl;
            return 0;
    }
}

int main() {
    double num1, num2;
    char op;
    
    // 输入两个操作数和一个运算符
    cin >> num1 >> num2 >> op;
    
    // 设置输出格式，保留两位小数
    cout << fixed << setprecision(2);
    
    // 调用square函数
    cout << "square(" << num1 << ") = " << square(num1) << endl;
    
    // 调用power函数（使用默认参数）
    cout << "power(" << num1 << ") = " << power(num1) << endl;
    
    // 调用power函数（指定指数为3）
    cout << "power(" << num1 << ",3) = " << power(num1, 3) << endl;
    
    // 调用calc函数（根据输入类型选择重载版本）
    // 如果输入是整数，调用int版本，否则调用double版本
    if (num1 == static_cast<int>(num1) && num2 == static_cast<int>(num2)) {
        int int1 = static_cast<int>(num1);
        int int2 = static_cast<int>(num2);
        double result = calc(int1, int2, op);
        if (!(op == '/' && int2 == 0)) {  // 如果不是除零错误，输出结果
            cout << int1 << " " << op << " " << int2 << " = " << result << endl;
        }
    } else {
        double result = calc(num1, num2, op);
        if (!(op == '/' && num2 == 0)) {  // 如果不是除零错误，输出结果
            cout << num1 << " " << op << " " << num2 << " = " << result << endl;
        }
    }
    
    return 0;
}
